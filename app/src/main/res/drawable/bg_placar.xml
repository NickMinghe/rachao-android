<?xml version="1.0" encoding="utf-8"?>
<!-- Painel do placar estilo ginásio -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/placar_borda" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/placar_fundo"
                android:startColor="@color/superficie" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
